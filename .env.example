# ---------------------------------------------------------------------------
# Vader — Tape Archive Control Application : example environment file
# Copy to .env and edit. All values shown are the built-in defaults.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Production: Postgres.  Dev / evaluation: SQLite (default).
# DATABASE_URL=postgresql+psycopg://vader:vader@localhost:5432/vader
DATABASE_URL=sqlite:///./data/vader.sqlite3

# --- Hardware backend -------------------------------------------------------
# "simulator" : in-memory library + directory-backed fake LTFS (no hardware).
# "real"      : drives mtx / mt / mkltfs / ltfs via subprocess on this host.
HARDWARE_BACKEND=simulator

# Real-hardware device nodes (only used when HARDWARE_BACKEND=real)
# CHANGER_DEVICE and each entry in DRIVE_DEVICES must be the SCSI-generic
# (/dev/sg*) node for that unit, NOT its /dev/nst*/dev/st* (st-driver) node --
# mkltfs/ltfs issue raw SG_IO ioctls that only /dev/sg* supports; pointing a
# drive at /dev/nst* mounts/formats fine on the surface but every real data
# read/write fails with a "Failed to execute SG_IO ioctl" error. Find the
# right mapping with `lsscsi -g` (matches by device, not by index order).
# On DDA/passthrough HBAs this numbering is NOT stable across a host-side VM
# reconfig + reboot -- confirmed live: a vCPU count change reshuffled every
# /dev/sg* node, which pointed the changer config at a tape drive and vice
# versa, failing loudly the moment anything touched the library ("READ
# ELEMENT STATUS Command Failed"). Re-run `lsscsi -g` and re-check this
# section after any such reboot; never assume the numbers held. Where
# possible, pin CHANGER_DEVICE to its /dev/tape/by-id/*-changer symlink
# instead (`ls -la /dev/tape/by-id/`) -- keyed by the unit's own serial, so
# it survives renumbering entirely. No such symlink covers the drives'
# /dev/sg* nodes specifically (by-id only has their /dev/st*/nst* nodes,
# which mkltfs/ltfs can't use), so DRIVE_DEVICES still needs re-checking by
# hand after a reboot.
CHANGER_DEVICE=/dev/sg3
DRIVE_DEVICES=/dev/sg1,/dev/sg2
# st-driver counterpart of each DRIVE_DEVICES entry (/dev/nst0, /dev/nst1,
# ...) -- needed only for `mt` commands, which need the st node rather than
# the SCSI-generic node above. Only used today to clear a stuck SCSI PREVENT
# MEDIUM REMOVAL lock (the Library page's Unlock button) after an unclean
# shutdown leaves a drive refusing to eject its tape. Leave unset if you
# don't need that button; get the mapping from `lsscsi -g`.
DRIVE_ST_DEVICES=/dev/nst0,/dev/nst1
LTFS_MOUNT_BASE=/mnt/ltfs

# Assumed native capacity (bytes) for a real tape auto-registered from a
# library scan with no capacity set yet on the Tapes page. Default is LTO-8
# (12 TB) — override to match whatever generation cartridges are in use
# (e.g. 18000000000000 for LTO-9).
DEFAULT_TAPE_CAPACITY_BYTES=12000000000000

# Simulator tuning (only used when HARDWARE_BACKEND=simulator)
SIM_STORAGE_SLOTS=24
SIM_DRIVES=2
SIM_TAPE_CAPACITY_BYTES=12000000000   # 12 GB "tapes" so spanning is easy to exercise
SIM_SEED_TAPES=true

# --- SMB Source Manager ------------------------------------------------------
# "simulator" : same credentials/mount/unit layout under DATA_DIR/sim/, no
#               systemctl calls, no root needed.
# "real"      : writes systemd units under SMB_SYSTEMD_DIR and drives them
#               with systemctl (needs root, or a scoped sudoers rule).
SMB_BACKEND=simulator
SMB_MOUNT_BASE=/mnt/vader
SMB_SYSTEMD_DIR=/etc/systemd/system
SMB_HEALTH_INTERVAL_SECONDS=300

# --- Paths ------------------------------------------------------------------
DATA_DIR=./data
BACKUP_DIR=./data/backups
# MANUAL_DIR=./user-manual   # Markdown source rendered live at /help

# --- Behaviour ------------------------------------------------------------
REVERIFY_MONTHS=12
DEFAULT_VERIFY_SAMPLE_FRACTION=0.1
WRITE_READBACK_VERIFY=true

# --- Auth (single-operator) ---------------------------------------------------
# Leave AUTH_TOKEN empty to disable auth entirely (VM is network-isolated).
# Set it to require a shared token at /login.
AUTH_TOKEN=
SESSION_SECRET=change-me-please
